<h1>Editar Produto</h1>

<form method="POST" action="/produtos/<%= produto.id %>/editar">

  <label>Descrição</label>
  <input name="descricao" value="<%= produto.descricao %>" required />

  <label>Valor</label>
  <input name="valor" type="number" step="0.01" value="<%= produto.valor %>" required />

  <label>Categoria</label>
  <select name="id_categoria">
    <option value="">Selecione</option>
    <% categorias.forEach(c => { %>
      <option value="<%= c.id %>"
        <%= produto.id_categoria == c.id ? 'selected' : '' %>>
        <%= c.descricao %>
      </option>
    <% }) %>
  </select>

  <label>Composição</label>
  <textarea name="composicao"><%= produto.composicao || '' %></textarea>

  <button class="btn">Salvar</button>
</form>
